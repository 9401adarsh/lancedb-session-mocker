# LanceDB database root inside your bucket.
LANCEDB_TEST_URI=s3://your-bucket/session-cache

# RGW or other S3-compatible endpoint.
AWS_ENDPOINT=http://127.0.0.1:12000
AWS_ALLOW_HTTP=true
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Copy your own S3 credentials here. Do not commit .env.
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
